# Supabase (Project settings -> API). The service role key is server-only: never expose it with NEXT_PUBLIC_.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Resend (https://resend.com -> API Keys). Server-only.
RESEND_API_KEY=re_xxxxxxxxx

# Sender. Must belong to a domain verified in Resend (Domains -> Add domain).
# Until the domain is verified, use "JC's Journeys <onboarding@resend.dev>": Resend then delivers
# only to the address that owns the Resend account, so guests get no copy yet.
RESEND_FROM_EMAIL="JC's Journeys <bookings@jcsjourneys.com>"

# Inboxes that receive every booking and guide request. One address, or several separated by commas.
BOOKINGS_NOTIFY_EMAIL=owner@example.com,bookings@jcsjourneys.com

# Optional. Where a guest's reply to their confirmation lands. Defaults to BOOKINGS_NOTIFY_EMAIL.
# BOOKINGS_REPLY_TO_EMAIL=bookings@jcsjourneys.com

# Public site URL used for metadata, sitemap and structured data
NEXT_PUBLIC_SITE_URL=https://jcsjourneys.com

# Google Analytics 4 measurement ID (Admin -> Data streams -> Web). Public value. Empty = Analytics off.
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Google Search Console verification code ("HTML tag" method: only the content="..." value). Public value.
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
