# Supabase (Project settings -> API). The service role key is server-only: never expose it with NEXT_PUBLIC_.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Resend (https://resend.com). The from address must belong to a domain verified in Resend.
RESEND_API_KEY=re_xxxxxxxxx
RESEND_FROM_EMAIL="JC's Journeys <bookings@jcsjourneys.com>"

# Where booking and guide requests are sent
BOOKINGS_NOTIFY_EMAIL=jcsjourneys@gmail.com

# Public site URL used for metadata, sitemap and structured data
NEXT_PUBLIC_SITE_URL=https://jcsjourneys.com
